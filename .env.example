# Required. Create a key at https://console.groq.com/keys
# At least one of GROQ_API_KEY or GROQ_API_KEY_1 must be set.
# Do not commit real keys. Copy this file to .env for local development.
GROQ_API_KEY=

# Optional extra keys. The server rotates across every distinct key that is set.
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
# GROQ_API_KEY_5=

# Optional model override. Defaults to openai/gpt-oss-120b.
# Other current Groq chat models include openai/gpt-oss-20b and qwen/qwen3.8-27b.
# GROQ_MODEL=openai/gpt-oss-120b
